AGENT_MEMORY_BASE_URL=https://gcp-us-east4.memory.redis.io
AGENT_MEMORY_STORE_ID=replace-with-your-store-id
AGENT_MEMORY_API_KEY=replace-with-your-store-api-key

# Stable defaults shared by Claude Code and Codex.
# Optional: set a stable personal ID to share ownership across computers.
# AGENT_MEMORY_OWNER_ID=your-stable-user-id
# Preferred: stable namespace resource ID created in Redis Agent Memory.
AGENT_MEMORY_NAMESPACE_ID=replace-with-your-namespace-id
# Legacy fallback for stores that do not use namespace resources:
# AGENT_MEMORY_NAMESPACE=project-memory
AGENT_MEMORY_AGENT_ID=shared-agent
