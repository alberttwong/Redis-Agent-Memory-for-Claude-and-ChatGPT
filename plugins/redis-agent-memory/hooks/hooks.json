{
  "description": "Automatically capture supported local turns and recall project context when a configured session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/server/capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture"
          }
        ]
      }
    ]
  }
}
