{
  "description": "Redis Agent Memory automatic capture hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/capture-cli.js\" hook codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\src\\capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/capture-cli.js\" hook codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\src\\capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/capture-cli.js\" hook codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\src\\capture-cli.js\" hook codex",
            "timeout": 30,
            "statusMessage": "Redis Agent Memory capture",
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
